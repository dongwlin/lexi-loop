  "info": {
    "description": "LexiLoop（词环）英语生词复习系统 /api/v1 接口。spec 由 `lexi-loop openapi` 离线生成至 docs/openapi/，请勿手改。",
    "title": "LexiLoop API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/reviews": {
      "post": {
        "operationId": "start-review-session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartSessionResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "开始一轮复习（抽词 + 建 session）",
        "tags": [
          "Reviews"
        ]
      }
    },
    "/api/v1/reviews/{id}": {
      "get": {
        "operationId": "get-review-session",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSessionResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "获取一轮复习的汇总与逐词结果",
        "tags": [
          "Reviews"
        ]
      }
    },
    "/api/v1/reviews/{sessionId}/items/{itemId}": {
      "post": {
        "operationId": "submit-review-result",
        "parameters": [
          {
            "in": "path",
            "name": "sessionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "itemId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitResultRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoData"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "提交一个单词的复习结果（幂等）",
        "tags": [
          "Reviews"
        ]
      }
    },
    "/api/v1/words": {
      "get": {
        "operationId": "list-words",
        "parameters": [
          {
            "explode": false,
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "pageSize",
            "schema": {
              "default": 20,
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListWordsResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "生词库分页列表（含搜索）",
        "tags": [
          "Words"
        ]
      }
    },
    "/api/v1/words/import": {
      "post": {
        "operationId": "import-words",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportWordsRequest"
              }
            }
          },
          "required": true
