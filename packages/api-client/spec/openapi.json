                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "批量导入生词（累计遇词次数）",
        "tags": [
          "Words"
        ]
      }
    },
    "/api/v1/words/{id}": {
      "delete": {
        "operationId": "delete-word",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
