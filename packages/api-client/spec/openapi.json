        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoData"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "删除生词（软删除）",
        "tags": [
          "Words"
        ]
      },
      "get": {
        "operationId": "get-word",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WordDetail"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "单词详情",
        "tags": [
          "Words"
        ]
      },
      "patch": {
        "operationId": "update-word-review-meaning",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateReviewMeaningRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoData"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "更新用户自定义复习释义（传 null 清除）",
        "tags": [
          "Words"
        ]
      }
    }
  }
}
